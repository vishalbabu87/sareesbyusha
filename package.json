{
  "name": "saree-studio-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --no-engine && next build",
    "build:next": "prisma generate --no-engine && next build",
    "pages:build": "next-on-pages",
    "pages:build:skip": "next-on-pages --skip-build",
    "pages:deploy": "wrangler pages deploy .vercel/output/static --project-name sareesbyusha",
    "pages:dev": "wrangler pages dev .vercel/output/static",
    "deploy": "npm run pages:build && npm run pages:deploy",
    "preview": "npm run pages:build && npm run pages:dev"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@prisma/extension-accelerate": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "firebase": "^12.11.0",
    "lucide-react": "^0.525.0",
    "next": "^15.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.1.3",
    "prisma": "^6.11.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vercel": "^50.43.0"
  }
}