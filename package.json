{
  "name": "saree-studio-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"const fs=require('fs'); if(fs.existsSync('.building')){ fs.unlinkSync('.building'); require('child_process').spawnSync('npm', ['run', 'next:build'], {stdio:'inherit', shell:true}); } else { fs.writeFileSync('.building',''); require('child_process').spawnSync('npm', ['run', 'pages:build'], {stdio:'inherit', shell:true}); }\"",
    "next:build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "pages:build": "next-on-pages",
    "pages:dev": "wrangler pages dev .vercel/output --transpile-only --compatibility-date=2024-01-01",
    "pages:deploy": "wrangler pages deploy .vercel/output",
    "deploy": "npm run pages:build && npm run pages:deploy",
    "preview": "npm run pages:build && npm run pages:dev"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.3",
    "firebase": "^12.11.0",
    "lucide-react": "^0.525.0",
    "next": "15.1.3",
    "prisma": "^6.11.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
